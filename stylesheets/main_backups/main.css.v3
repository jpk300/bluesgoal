* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at 50% 0%, rgba(252, 181, 20, 0.2), transparent 34%),
        linear-gradient(180deg, #06152d 0%, #0a2c62 48%, #020917 100%);
    color: #ffffff;
}

.page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 3vmin, 34px);
    padding: clamp(12px, 3vmin, 42px);
}

.hero {
    width: min(1180px, 100%);
    margin: 0 auto;
    overflow: hidden;
    border: clamp(5px, 1vmin, 10px) solid #002f87;
    box-shadow:
        0 0 0 clamp(3px, 0.65vmin, 7px) #fcb514,
        0 18px 46px rgba(0, 0, 0, 0.45);
    background: #020917;
}

.hero__image {
    display: block;
    width: 100%;
    height: clamp(96px, 22vh, 260px);
    object-fit: cover;
    object-position: center;
}

.button-grid {
    --page-pad: clamp(12px, 3vmin, 42px);
    --gap: clamp(12px, 3.5vmin, 44px);
    --button-size: min(
        calc((100vw - (2 * var(--page-pad)) - (2 * var(--gap))) / 3),
        calc((100vh - 160px - (2 * var(--page-pad)) - var(--gap)) / 2),
        260px
    );

    display: grid;
    grid-template-columns: repeat(3, var(--button-size));
    gap: var(--gap);
    justify-content: center;
    align-content: center;
    width: 100%;
}

.control-button {
    display: block;
    width: var(--button-size);
    aspect-ratio: 1;
    padding: clamp(7px, 1.3vmin, 14px);
    background: #002f87;
    overflow: hidden;
    text-decoration: none;
    touch-action: manipulation;
    border: 2px solid rgba(255, 255, 255, 0.16);
    box-shadow:
        0 12px 26px rgba(0, 0, 0, 0.34),
        inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    transition: transform 120ms ease, box-shadow 120ms ease;
}

.control-button--wide {
    aspect-ratio: 2 / 1;
}

.control-button:focus-visible {
    outline: 4px solid #ffffff;
    outline-offset: 4px;
}

.control-button:active {
    transform: scale(0.97);
}

.control-button:hover {
    box-shadow:
        0 14px 32px rgba(0, 0, 0, 0.44),
        0 0 24px rgba(252, 181, 20, 0.3),
        inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
}

.control-button:hover:active {
    transform: scale(0.97);
}

.control-button__inner {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(7px, 1.5vmin, 16px);
    background:
        linear-gradient(145deg, #ffd761 0%, #fcb514 48%, #d99b00 100%);
}

.control-button img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

@media (max-width: 620px) {
    .page {
        justify-content: flex-start;
        padding: 12px;
    }

    .hero__image {
        height: clamp(78px, 20vh, 136px);
    }

    .button-grid {
        --gap: 12px;
        --button-size: calc((100vw - 48px) / 3);
    }
}
