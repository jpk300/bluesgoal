* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
}

.page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vmin, 56px);
}

.button-grid {
    --gap: clamp(14px, 5vmin, 72px);
    --button-size: min(
        calc((100vw - (2 * clamp(16px, 4vmin, 56px)) - (2 * var(--gap))) / 3),
        calc((100vh - (2 * clamp(16px, 4vmin, 56px)) - var(--gap)) / 2),
        320px
    );

    display: grid;
    grid-template-columns: repeat(3, var(--button-size));
    gap: var(--gap);
    justify-content: center;
    align-content: center;
}

.control-button {
    display: block;
    width: var(--button-size);
    aspect-ratio: 1;
    padding: clamp(7px, 1.3vmin, 14px);
    background: #002f87;
    overflow: hidden;
    text-decoration: none;
    touch-action: manipulation;
}

.control-button:focus-visible {
    outline: 4px solid #ffffff;
    outline-offset: 4px;
}

.control-button:active {
    transform: scale(0.97);
}

.control-button__inner {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(7px, 1.5vmin, 16px);
    background: #fcb514;
}

.control-button img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

@media (max-width: 420px) {
    .page {
        padding: 10px;
    }

    .button-grid {
        --gap: 10px;
        --button-size: calc((100vw - 40px) / 3);
    }
}
